{
  "name": "@school-mgmt/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/scripts/reset.ts"
  },
  "devDependencies": {
    "@school-mgmt/config": "workspace:*",
    "@types/node": "24.19.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "10.15.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@school-mgmt/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  }
}
