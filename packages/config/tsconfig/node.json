{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    // Node apps run with tsx in dev and are bundled with tsup for production,
    // so they resolve imports like a bundler (workspace packages ship TS source).
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  }
}
