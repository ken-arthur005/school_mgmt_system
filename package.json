{
  "name": "school-mgmt-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @school-mgmt/db db:generate",
    "db:migrate": "pnpm --filter @school-mgmt/db db:migrate",
    "db:seed": "pnpm --filter @school-mgmt/db db:seed",
    "db:reset": "pnpm --filter @school-mgmt/db db:reset",
    "db:test:up": "docker compose up -d --wait",
    "auth:dev-logins": "pnpm --filter @school-mgmt/api auth:dev-logins"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3"
  }
}
