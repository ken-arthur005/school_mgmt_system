# Public: everything prefixed VITE_ is bundled into the app. Never put secrets here.
VITE_API_URL=http://localhost:3000
# Supabase project URL and the *publishable* key (Project Settings → API keys). Used to sign in.
# Never the secret key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
