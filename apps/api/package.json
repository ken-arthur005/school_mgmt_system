{
  "name": "@school-mgmt/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "auth:dev-logins": "tsx --env-file-if-exists=.env src/scripts/create-dev-logins.ts",
    "storage:setup": "tsx --env-file-if-exists=.env src/scripts/setup-storage.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@school-mgmt/db": "workspace:*",
    "@supabase/supabase-js": "^2.119.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "^6.2.18",
    "libphonenumber-js": "^1.13.17",
    "postgres": "^4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@school-mgmt/config": "workspace:*",
    "@school-mgmt/shared": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
