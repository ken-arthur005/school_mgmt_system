# development | staging | production
APP_ENV=development
PORT=3000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated web origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Server-only secret: Supabase "Session pooler" connection string (Connect → Session pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# Your Supabase project URL. Login tokens are checked against its public keys (JWKS).
SUPABASE_URL=https://<project-ref>.supabase.co

# --- Only for `pnpm auth:dev-logins` (dev/staging seed data; refuses production) ---
# Server-only secret: Project Settings → API keys → secret key. Never put it in a VITE_ variable.
SUPABASE_SECRET_KEY=
# The password every dev login gets (at least 12 characters)
DEV_LOGIN_PASSWORD=

# Local Docker database for the tests (`pnpm db:test:up`). The API tests create and use their own
# database on this server (school_mgmt_test_api). Tests refuse non-local URLs.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/school_mgmt_test
